# ==============================================================================
# Airport Cargo & Warehouse Management System - Environment Variables
# ==============================================================================

# Server Network Port
PORT=3000

# Environment Mode: 'development' or 'production'
NODE_ENV=development

# MongoDB Atlas or Community Server Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/airport_cargo?retryWrites=true&w=majority
MONGODB_URI=""

# JSON Web Token Secret Key for Session Authentication
JWT_SECRET="airport-cargo-jwt-super-secret-key-college-demo-2026"
JWT_EXPIRES_IN="24h"

# Allowed Client Origin for CORS
CLIENT_URL="http://localhost:3000"

# Redis Server URL (Optional: high-performance tracking cache-aside)
# Example: redis://default:<password>@redis-host.com:6379
# If omitted or offline, the system seamlessly uses built-in in-memory caching fallback.
REDIS_URL=""
REDIS_TTL_SECONDS=120

# Frontend API URL for Production Deployments (Vercel)
VITE_API_URL="/api"
